{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/augustinepaulm/BYOB-fit/program.schema.json",
  "title": "BYOB-fit program file",
  "description": "Frozen at Gate 2, Sep 13, 2026 (PLAN v1.3 section 5). A program is a 7-day template with per-week overrides. Sessions, profile, meals and settings are separate stores and are not part of this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "weekStartsOn", "programWeeks", "startDate", "exercises", "days"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "description": "Free text, e.g. v11" },
    "weekStartsOn": { "const": "sunday" },
    "programWeeks": { "type": "integer", "minimum": 1, "maximum": 52 },
    "startDate": { "type": "string", "format": "date", "description": "The Sunday that begins program week 1. currentWeek is derived: floor((today - startDate) / 7 days) + 1, clamped to 1..programWeeks." },
    "notes": { "type": "string" },
    "exercises": {
      "type": "object",
      "description": "Keyed by exercise id",
      "additionalProperties": { "$ref": "#/$defs/exercise" }
    },
    "days": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/day" }
    }
  },
  "$defs": {
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "howTo"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "howTo": { "type": "string", "description": "One to three sentences shown under 'How to perform'" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "name", "sections"],
      "properties": {
        "id": { "type": "string" },
        "order": { "type": "integer", "minimum": 0, "maximum": 6, "description": "0 = Sunday" },
        "name": { "type": "string" },
        "focus": { "type": "string" },
        "durationMin": { "type": "integer", "minimum": 0 },
        "swappableWith": { "type": "string", "description": "Day id this day may swap with in a given week" },
        "rest": { "type": "boolean" },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "items"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["warmup", "main", "block", "abs", "cardio", "cooldown", "daily"] },
        "title": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
      }
    },
    "itemFields": {
      "type": "object",
      "properties": {
        "exerciseId": { "type": "string" },
        "type": { "enum": ["load_reps", "bodyweight_reps", "timed_hold", "distance", "cardio_block", "check"] },
        "perSide": { "type": "boolean" },
        "sets": { "type": "integer", "minimum": 1 },
        "repMin": { "type": "integer", "minimum": 1 },
        "repMax": { "type": "integer", "minimum": 1 },
        "holdSec": { "type": "integer", "minimum": 1 },
        "distanceM": { "type": "integer", "minimum": 1 },
        "minutes": { "type": "integer", "minimum": 1 },
        "tempo": { "type": "string", "description": "e.g. 3-1-1" },
        "restSec": { "type": "integer", "minimum": 0 },
        "rpe": { "type": "string", "description": "e.g. 8 or 7 to 8" },
        "unit": { "enum": ["kg", "lb"], "description": "Load unit for load_reps items; shown as entered, no conversion" },
        "index": { "type": "boolean", "description": "Index lift: monitored between scans, surfaced in Log, subject to the >5% rule" },
        "logged": { "type": "boolean", "description": "Overrides the section default: main/block/abs log per set, cardio logs minutes, warmup/cooldown/daily are check-off" },
        "cue": { "type": "string", "description": "Short coaching cue shown on the tile in muted text" },
        "notes": { "type": "string" },
        "alternateExerciseId": { "type": "string", "description": "One-tap substitute; the session records which was done" }
      }
    },
    "item": {
      "allOf": [
        { "$ref": "#/$defs/itemFields" },
        {
          "type": "object",
          "required": ["id", "exerciseId", "type"],
          "properties": {
            "id": { "type": "string" },
            "byWeek": {
              "type": "object",
              "description": "Keys are program week numbers as strings. An override applies from that week onward until a higher key takes over. Any itemFields property may be overridden, including exerciseId for staged progressions.",
              "propertyNames": { "pattern": "^[0-9]{1,2}$" },
              "additionalProperties": { "$ref": "#/$defs/itemFields" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
